{
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "bracketSpacing": true,
  "overrides": [
    {
      "files": ["*.md"],
      "options": { "printWidth": 80, "proseWrap": "preserve" }
    },
    {
      "files": ["*.css"],
      "options": { "singleQuote": false }
    }
  ]
}
