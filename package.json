{
  "name": "bodysnatch-desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "BodySnatch Desktop — подмена JS/CSS сайта локальными файлами через локальный MITM-прокси",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "node proxy/src/main.mjs",
    "shell": "electron shell/main.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=30000 \"test/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"ui/src/**/*.css\"",
    "lint": "npm run typecheck && npm run format:check && npm run lint:css",
    "icons": "electron scripts/make-icons.cjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "splash": "electron shell/main.cjs --splash",
    "splash:dev": "electron shell/main.cjs --splash --dev"
  },
  "dependencies": {
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "author": "Nefritor",
  "main": "shell/main.cjs",
  "build": {
    "appId": "dev.nefritor.bodysnatch",
    "productName": "BodySnatch",
    "copyright": "Nefritor",
    "artifactName": "BodySnatch-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "shell/**",
      "proxy/src/**",
      "config/rules.default.json",
      "ui/dist/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "shell/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "language": "1049"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
